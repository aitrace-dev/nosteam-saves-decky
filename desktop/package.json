{
  "name": "nosteam-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "npm run build && node --test tests/desktop.e2e.mjs",
    "package:linux": "npm run build && electron-packager . NoSteam --platform=linux --arch=x64 --out=out --overwrite --ignore='^/(src|tests|out)(/|$)|^/preview[.]html$'"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "electron": "45.1.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.0"
  }
}
